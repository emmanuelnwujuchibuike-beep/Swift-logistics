# Enforce LF line endings for all text files — prevents CRLF conversion on Windows
* text=auto eol=lf

# Explicitly mark binary files as binary (no EOL processing)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
